DEBUG=False
SECRET_KEY=replace-this-with-a-long-random-secret-key-at-least-32-characters

# Backend domain plus loopback hosts used by the container health check.
ALLOWED_HOSTS=moses.dev.approovia.net,localhost,127.0.0.1

# Only the deployed frontend may call the API from a browser.
CORS_ALLOWED_ORIGINS=https://calvision-two.vercel.app
CSRF_TRUSTED_ORIGINS=https://moses.dev.approovia.net,https://calvision-two.vercel.app

ALLOW_NGROK=False

POSTGRES_DB=calvision
POSTGRES_USER=calvision
POSTGRES_PASSWORD=replace-this-with-a-strong-database-password
DATABASE_URL=postgresql://calvision:replace-this-with-a-strong-database-password@db:5432/calvision

USDA_API_KEY=DEMO_KEY
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=300

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Caddy performs the public HTTP-to-HTTPS redirect. Keep Django's redirect off so
# its internal HTTP health check remains available.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
